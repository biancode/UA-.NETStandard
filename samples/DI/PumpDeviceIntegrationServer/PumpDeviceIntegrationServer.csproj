<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>PumpDeviceIntegrationServer</AssemblyName>
    <PackageId>PumpDeviceIntegrationServer</PackageId>
    <Description>Self-contained .NET console OPC UA server demonstrating the OPC 40223 Pumps companion specification end-to-end, including full simulation and additive OPC 10000-100 topology-element builder integration.</Description>
    <RootNamespace>Pumps</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Di\Opc.Ua.Di.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Di.Server\Opc.Ua.Di.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Machinery\Opc.Ua.Machinery.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.OpenUsd\Opc.Ua.OpenUsd.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.OpenUsd.Server\Opc.Ua.OpenUsd.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <!-- Artist-authored USD layers embedded so the server ships (and serves) its own
       twin geometry: Plant.usda (RootLayer) + pump.usda (Reference). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Plant.usda"><LogicalName>Plant.usda</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Assets\pump.usda"><LogicalName>pump.usda</LogicalName></EmbeddedResource>
  </ItemGroup>
  <!-- The Pumps NodeSet2 XML is source-generated locally. The generator emits
       typed classes, a NodeId table and the AddOpcUaPumps extension method in
       the Opc.Ua.Pumps namespace, internal to this assembly.

       Machinery is no longer generated here: this sample used to carry a
       reduced copy of the Machinery NodeSet because the full one did not
       survive the model generator, and that defect is fixed. The
       ProjectReference on src/Opc.Ua.Machinery now supplies the full OPC
       40001-1 1.04.1 model - the same 180 nodes every other Machinery consumer
       sees - and the Pumps model resolves its Machinery type references
       through that assembly's [ModelDependencyAttribute] payload, the way it
       already resolved its DI references.

       The matching Opc.Ua.Pumps.NodeSet2.csv (alongside the XML) is picked up
       as the stable NodeId table. Without it the generator would assign
       synthetic NodeIds at compile time, breaking byte-stable wire formats for
       clients that cache NodeIds across builds. -->
  <ItemGroup>
    <AdditionalFiles Include="Model\Opc.Ua.Pumps.NodeSet2.xml">
      <ModelSourceGeneratorPrefix>Opc.Ua.Pumps</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\Opc.Ua.Pumps.NodeSet2.csv" />
  </ItemGroup>
  <Import Project="..\..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
  </PropertyGroup>
</Project>
